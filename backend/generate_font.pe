# קוד רץ בתוך FontForge
Print("🚀 Running FontForge...")

# קלט מהשורת פקודה
input_path = $1
output_path = $2
json_path = $3

Print("📁 SVG folder: " + input_path)
Print("📄 Output path: " + output_path)
Print("📄 JSON map path: " + json_path)

# יצירת פונט חדש
New()
SetFontNames("HebrewFont", "Hebrew Font", "Hebrew Font")
SetFontEncoding("UnicodeFull")
SetFontAscent(800)
SetFontDescent(200)
ScaleToEm(1000, 0)

# טען את הקוד יוניקוד מכל משתנה גלובלי (שנטען ע"י JSON מפייתון)
glyph_count = 0
svg_files = ListDirectory(input_path)

foreach(filename, svg_files)
    if (StrRight(filename, 4) != ".svg")
        continue
    endif

    parts = StrSplit(filename, "_")
    if (SizeOf(parts) != 2)
        continue
    endif

    name = StrLeft(StrRight(filename, StrLen(filename) - SizeOf(parts[0]) - 1), StrLen(filename) - SizeOf(parts[0]) - 5)

    code = GetGlobal(name)
    if (code == 0)
        Print("⚠ לא נמצא קוד עבור " + name)
        continue
    endif

    Select(code)
    Import(input_path + "/" + filename)

    box = GetBoundingBox()
    if (box[0] == 0 && box[1] == 0 && box[2] == 0 && box[3] == 0)
        continue
    endif

    SetWidth((box[2] - box[0]) + 80)
    SetLBearing(27)
    SetRBearing(27)

    glyph_count += 1
endloop

if (glyph_count > 0)
    Generate(output_path)
    Print("✅ Font created at: " + output_path)
else
    Print("❌ No glyphs were added.")
endif

Quit()
