Print("🚀 Running FontForge...")

input_path = $1
output_path = $2
json_path = $3

Print("📁 SVG folder: " + input_path)
Print("📄 Output path: " + output_path)
Print("📄 JSON map path: " + json_path)

font = New()
font.encoding = "UnicodeFull"
font.fontname = "HebrewFont"
font.familyname = "Hebrew Font"
font.fullname = "Hebrew Font"
font.em = 1000
font.ascent = 800
font.descent = 200

# קריאת קובץ JSON עם המיפוי
json = ReadFile(json_path)
json = Strsub(json, "{", "")
json = Strsub(json, "}", "")
json = Strsub(json, "\"", "")
json = Strsub(json, " ", "")
pairs = StrSplit(json, ",")

i = 0
while (i < SizeOf(pairs))
    kv = StrSplit(pairs[i], ":")
    if (SizeOf(kv) == 2)
        name = kv[0]
        code = Strtol(kv[1])
        SetGlobal(name, code)
    endif
    i += 1
endloop

glyph_count = 0
files = ListDirectory(input_path)

foreach (f, files)
    if (StrRight(f, 4) != ".svg")
        continue
    endif

    parts = StrSplit(f, "_")
    if (SizeOf(parts) != 2)
        continue
    endif

    name = Strsub(parts[1], ".svg", "")
    code = GetGlobal(name)
    if (code == 0)
        continue
    endif

    glyph = font.createChar(code, name)
    glyph.importOutlines(input_path + "/" + f)

    box = glyph.boundingBox()
    if (box[0] == box[2] && box[1] == box[3])
        continue
    endif

    glyph.width = (box[2] - box[0]) + 80
    glyph.left_side_bearing = 27
    glyph.right_side_bearing = 27

    glyph_count += 1
endloop

if (glyph_count > 0)
    font.generate(output_path)
    Print("✅ Font created at: " + output_path)
else
    Print("❌ No glyphs were added.")
endif

Quit()

