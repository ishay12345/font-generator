Print("🚀 Running FontForge...")

input_path = $1
output_path = $2

Print("📁 SVG folder: " + input_path)
Print("📄 Output path: " + output_path)

New()
Reencode("UnicodeFull")
SetFontNames("HebrewFont", "Hebrew Font", "Hebrew Font")
SetFontHasEm(1000)
SetFontAscent(800)
SetFontDescent(200)

# מיפוי שם לאותיות ביוניקוד
SetGlobal("alef", 0x05D0)
SetGlobal("bet", 0x05D1)
SetGlobal("gimel", 0x05D2)
SetGlobal("dalet", 0x05D3)
SetGlobal("he", 0x05D4)
SetGlobal("vav", 0x05D5)
SetGlobal("zayin", 0x05D6)
SetGlobal("het", 0x05D7)
SetGlobal("tet", 0x05D8)
SetGlobal("yod", 0x05D9)
SetGlobal("kaf", 0x05DB)
SetGlobal("lamed", 0x05DC)
SetGlobal("mem", 0x05DE)
SetGlobal("nun", 0x05E0)
SetGlobal("samekh", 0x05E1)
SetGlobal("ayin", 0x05E2)
SetGlobal("pe", 0x05E4)
SetGlobal("tsadi", 0x05E6)
SetGlobal("qof", 0x05E7)
SetGlobal("resh", 0x05E8)
SetGlobal("shin", 0x05E9)
SetGlobal("tav", 0x05EA)
SetGlobal("final_kaf", 0x05DA)
SetGlobal("final_mem", 0x05DD)
SetGlobal("final_nun", 0x05DF)
SetGlobal("final_pe", 0x05E3)
SetGlobal("final_tsadi", 0x05E5)

glyph_count = 0
svg_files = ListDirectory(input_path)

foreach(filename, svg_files)
    if (StrRight(filename, 4) != ".svg")
        continue
    endif

    parts = StrSplit(filename, "_")
    if (SizeOf(parts) != 2)
        continue
    endif

    name = StrLeft(StrRight(filename, StrLen(filename)-SizeOf(parts[0])-1), StrLen(filename)-SizeOf(parts[0])-5)
    code = GetGlobal(name)
    if (code == 0)
        continue
    endif

    glyph = CreateChar(code, name)
    glyph.importOutlines(input_path + "/" + filename)

    box = glyph.boundingBox()
    if (box[0] == box[2] && box[1] == box[3])
        continue
    endif

    glyph.width = (box[2] - box[0]) + 80
    glyph.left_side_bearing = 27
    glyph.right_side_bearing = 27

    glyph_count += 1
endloop

if (glyph_count > 0)
    Generate(output_path)
    Print("✅ Font created at: " + output_path)
else
    Print("❌ No glyphs were added.")
endif

Quit()

